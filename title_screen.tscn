[node name="RulesText" type="RichTextLabel" parent="HowToModal/CenterContainer/PanelContainer/MarginContainer/VBoxContainer/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 2
theme_override_font_sizes/normal_font_size = 15
bbcode_enabled = true
text = "[color=#ffeb99][b]1. 게임의 목표[/b][/color]
안개 낀 어둠의 숲을 탐색하며 흩어진 [color=#ffd166][b]10개의 수학 쪽지[/b][/color]를 모두 찾아 문제를 풀고 숲을 탈출하세요!

[color=#ffeb99][b]2. 초등 6학년 수학 핵심 공식[/b][/color]
• [color=#a0e426]원주 (원의 둘레)[/color] = 지름 × 원주율 (2 × 반지름 × 원주율)
• [color=#a0e426]원주율[/color] = 원주 ÷ 지름 (주로 3 또는 3.14)
• [color=#a0e426]원의 넓이[/color] = 반지름 × 반지름 × 원주율

[color=#ffeb99][b]3. 태블릿 / 모바일 & PC 조작법[/b][/color]
• [color=#ffd166][b]태블릿 터치 조작:[/b][/color] 왼쪽 하단 [b]조이스틱[/b]으로 이동, 화면 빈 곳을 [b]드래그[/b]하여 시점 회전, 오른쪽 하단 [b][📜쪽지 풀기] · [🏃달리기] · [🔦손전등][/b] 버튼을 터치하세요!
• [color=#48cae4][b]안심 풀이:[/b][/color] 쪽지 문제를 푸는 동안에는 괴물이 [b]완전히 정지[/b]하여 플레이어를 잡지 않습니다.
• [color=#f72585][b]추격 시 탈출:[/b][/color] 괴물이 쫓아올 때는 [b]🏃달리기 버튼(또는 Shift)[/b]을 켜고 전력질주하세요. 몇 초 뒤면 괴물이 스윽 안개 속으로 사라집니다!

[color=#ffd166][b]🎓 기획 및 출처 : 하모쌤[/b][/color]"
fit_content = true
scroll_active = false

